PROJECT_NAME="SIH26028 - Dynamic Train ETA Forecast System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEFAULT_SPEED_MULTIPLIER=5
KALMAN_FILTER_ENABLED=true
MONTE_CARLO_SAMPLES=100
DATABASE_URL="sqlite:///./railway_eta.db"

# Where Is My Train API Credentials & Configuration
# Provide official credentials when available. Leave blank to use MockHistoricalDataAdapter automatically.
WHERE_IS_MY_TRAIN_API_KEY=
WHERE_IS_MY_TRAIN_BASE_URL=
WHERE_IS_MY_TRAIN_API_VERSION=v1
WHERE_IS_MY_TRAIN_CLIENT_ID=
WHERE_IS_MY_TRAIN_CLIENT_SECRET=
WHERE_IS_MY_TRAIN_AUTH_HEADER=
WHERE_IS_MY_TRAIN_ENDPOINT=

# Rate Limiting Configuration
REQUEST_DELAY=1.0
MAX_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=1
